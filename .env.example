# Copy to .env (git-ignored) and fill in from Supabase → Project Settings → API.
# These two are safe in the app bundle; row-level security protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Local scripts only (seed, RLS check). Never commit, never put in GitHub variables.
SUPABASE_SERVICE_ROLE_KEY=
